<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="safebox.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" />
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="safebox.db" />
    </device-transfer>
</data-extraction-rules>
